{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/ai.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    }
  ],
  "redirects": [
    { "source": "/services/signature-website.html", "destination": "/signature-website/", "permanent": true },
    { "source": "/services/ai-automations.html", "destination": "/ai-automations/", "permanent": true },
    { "source": "/services/agentic-ai.html", "destination": "/agentic-ai/", "permanent": true },
    { "source": "/services/ai-videos.html", "destination": "/ai-videos/", "permanent": true },
    { "source": "/services/signature-website", "destination": "/signature-website/", "permanent": true },
    { "source": "/services/ai-automations", "destination": "/ai-automations/", "permanent": true },
    { "source": "/services/agentic-ai", "destination": "/agentic-ai/", "permanent": true },
    { "source": "/services/ai-videos", "destination": "/ai-videos/", "permanent": true }
  ]
}
